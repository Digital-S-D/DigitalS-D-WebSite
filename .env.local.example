# ─── VARIÁVEIS DE AMBIENTE ─────────────────────────────────────────────
# Copie este arquivo para ".env.local" (que já está no .gitignore) e
# preencha com o valor real. Nunca commite o arquivo ".env.local" em si.

# Endpoint do Formspree usado pelo formulário de contato (ContactSection.tsx).
# Como obter:
#   1. Crie uma conta grátis em https://formspree.io
#   2. Crie um novo formulário configurando o e-mail de destino como
#      digitalsd.contato@gmail.com
#   3. Copie a URL do endpoint (formato: https://formspree.io/f/xxxxxxx)
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/SEU_ID_AQUI

# Opcional: somente o conteúdo real de google-site-verification fornecido
# pelo Search Console ao verificar uma propriedade por prefixo de URL.
# Também precisa ser definido no ambiente de build da hospedagem.
# Não é necessário se a propriedade já estiver verificada por DNS.
GOOGLE_SITE_VERIFICATION=
