// Review and replace the database ID before any deployment. No resource is created by this file.
{
  "name": "digitalsd-measurement-cleanup",
  "main": "measurement-cleanup.js",
  "compatibility_date": "2026-11-10",
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [{ "binding": "MEASUREMENT_DB", "database_name": "REPLACE_WITH_PREVIEW_DATABASE", "database_id": "REPLACE_WITH_APPROVED_DATABASE_ID" }]
}
